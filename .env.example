# GraphQL API endpoint URL override
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql
# GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# Fallback lifetime (seconds) for the axus_refresh_token cookie, used only when
# AXUS ID does not advertise a refresh-token TTL of its own. Defaults to 30 days.
# AXUS_REFRESH_TOKEN_TTL=2592000
