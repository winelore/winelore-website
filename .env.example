# GraphQL API endpoint URL override
# NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql
# GRAPHQL_ENDPOINT=http://localhost:8080/graphql

# AXUS ID (OAuth / user directory)
# NEXT_PUBLIC_AXUS_ID_ISSUER=https://axusid-website.vercel.app
# NEXT_PUBLIC_AXUS_ID_CLIENT_ID=your_client_id
# NEXT_PUBLIC_AXUS_ID_REDIRECT_URI=http://localhost:3000/callback
# NEXT_PUBLIC_AXUS_GRAPHQL_ENDPOINT=https://axusid.thewinelore.com/graphql
# AXUS_GRAPHQL_ENDPOINT=https://axusid.thewinelore.com/graphql

# Live events (SSE). Derived from GRAPHQL_ENDPOINT when unset.
# EVENTS_ENDPOINT=http://localhost:8080/api/v1/events
# NEXT_PUBLIC_EVENTS_ENDPOINT=http://localhost:8080/api/v1/events

# Fallback lifetime (seconds) for the axus_refresh_token cookie, used only when
# AXUS ID does not advertise a refresh-token TTL of its own. Defaults to 30 days.
# AXUS_REFRESH_TOKEN_TTL=2592000
# Primary AI Provider (Vercel AI SDK / Google Gemini)
# Get a free key here: https://aistudio.google.com/
#AI Tasting Summary Provider ('google' or 'openai')
#AI_PROVIDER=google
#AI_MODEL_NAME=gemini-3.6-flash
#GOOGLE_GENERATIVE_AI_API_KEY=your_api_key

# Alternative AI Provider (OpenAI - for future scale)
# OPENAI_API_KEY=