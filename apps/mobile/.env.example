# Normally you need NOTHING here.
#
# AXUS ID is a public OAuth client — no secret, PKCE only — so the iOS app
# shares the web app's client id. app.config.ts reads the repo-root .env
# (NEXT_PUBLIC_AXUS_ID_*) at build time, so web and native cannot drift apart.
#
# Set these only to point a build at a different AXUS ID deployment; they take
# precedence over the root .env.
# EXPO_PUBLIC_AXUS_ID_CLIENT_ID=
# EXPO_PUBLIC_AXUS_ID_ISSUER=
# EXPO_PUBLIC_AXUS_GRAPHQL_ENDPOINT=
# EXPO_PUBLIC_GRAPHQL_ENDPOINT=
