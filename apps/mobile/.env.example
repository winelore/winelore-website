# AXUS ID OAuth client registered for the iOS app. This must be a SEPARATE
# client from the web one: its allowed redirect URIs are custom schemes
# (winelore://callback) plus the Expo development proxy URL, and native clients
# are public — they hold no client secret, which is why PKCE is required.
EXPO_PUBLIC_AXUS_ID_CLIENT_ID=

# Optional overrides; the defaults match the web app's.
# EXPO_PUBLIC_AXUS_ID_ISSUER=https://axusid-website.vercel.app
# EXPO_PUBLIC_AXUS_GRAPHQL_ENDPOINT=https://axusid.thewinelore.com/graphql
# EXPO_PUBLIC_GRAPHQL_ENDPOINT=https://winelore-dev.thewinelore.com/graphql
